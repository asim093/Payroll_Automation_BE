# Azure AD tenant ID for the app registration used to call Microsoft Graph
TENANT_ID=

# Azure AD application (client) ID
CLIENT_ID=

# Azure AD application client secret
CLIENT_SECRET=

# MongoDB connection string (Atlas or local), including the database name
MONGODB_URI=

# Mailbox address to poll via Microsoft Graph. Leave empty until a real
# mailbox is available — see backend/SETUP_MAILBOX.md
TEST_MAILBOX_EMAIL=

# Port the Express server listens on
PORT=5000

# Dropbox API credentials
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# DEPRECATED - short-lived static token, no longer read by the code.
# Kept only for reference; DROPBOX_REFRESH_TOKEN below replaces it.
DROPBOX_ACCESS_TOKEN=
# Long-lived refresh token — obtained by running `node getDropboxRefreshToken.js`
# once and pasting its console output here. Never share this value.
DROPBOX_REFRESH_TOKEN=

# Delegated (Authorization Code Flow) auth — for personal Microsoft accounts
# (e.g. outlook.com), separate from the client-credentials flow above.
# Same app as CLIENT_ID, kept as its own variable since this is a parallel flow.
DELEGATED_CLIENT_ID=
# Local redirect URI registered on the app for the Authorization Code Flow
REDIRECT_URI=http://localhost:3000/redirect
# Long-lived refresh token — obtained by running `node getRefreshToken.js`
# once and pasting its console output here. Never share this value.
DELEGATED_REFRESH_TOKEN=
# Mailbox the delegated flow polls via "me" — used only for logging, since
# "me" already resolves to whichever account DELEGATED_REFRESH_TOKEN belongs to.
DELEGATED_MAILBOX_EMAIL=

# ShareFile API credentials (OAuth2 password grant) — real trial account
SHAREFILE_CLIENT_ID=
SHAREFILE_CLIENT_SECRET=
SHAREFILE_SUBDOMAIN=
SHAREFILE_USERNAME=
SHAREFILE_PASSWORD=

# PHASE 9 — real-time dashboard updates via WebSocket. Read by
# services/scanActivityService.js's notify() — set on whichever process
# actually RUNS the scan (scheduler.js and/or runScanOnce.js), not
# necessarily on the web service's own env (though it's harmless there too,
# just unused). If either is left blank, notifications are silently skipped
# (no error) — the dashboard just falls back to its last GET
# /api/scan-activity fetch, same as before Phase 9.
#
# Base URL of the web service (the one running server.js) that the
# scan-runner process should POST progress-ticks to. For local dev with
# everything on one machine, http://localhost:5000 (or whatever PORT is set
# to). On Render, this is the web service's own URL - see render.yaml.
WEB_SERVICE_INTERNAL_URL=
# Shared secret both the web service (to verify) and the scan-runner
# process (to send) must have the exact same value for. Pick any long
# random string — never share it. Required on the WEB SERVICE for
# POST /internal/notify-progress to work at all (controllers/
# internalController.js returns 500 without it, regardless of what the
# caller sends).
INTERNAL_NOTIFY_SECRET=
